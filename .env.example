# Copy to ioc_extraction_agent/.env. `adk web`, `adk run` and run.py all load it.

# Model: any LiteLLM model string, plus the credential its provider reads.
#   openrouter/z-ai/glm-4.7-flash      -> OPENROUTER_API_KEY
#   gemini/gemini-2.5-flash            -> GEMINI_API_KEY
#   bedrock/us.anthropic.claude-sonnet-5 -> AWS_* (pip install boto3)
SECOPS_MODEL=openrouter/z-ai/glm-4.7-flash
OPENROUTER_API_KEY=

# Google SecOps tenant for the read-only IOC check (same values as investigationAgent).
# Leave empty to skip the check; extraction works either way.
SECOPS_MCP_URL=
SECOPS_PROJECT_ID=
SECOPS_CUSTOMER_ID=
SECOPS_REGION=

# Google auth for SecOps: the path to a service-account key (JSON). The account
# needs the Chronicle API viewer role on the tenant's project. Write the path
# unquoted, as your OS spells it; `~` and $VAR / %VAR% are expanded, and a relative
# path is taken from the project root (the folder holding run.py). Examples:
#   Windows:  C:\Users\khanh\keys\secops-sa.json   (no double quotes: "\t" becomes a tab)
#   macOS:    ~/keys/secops-sa.json
#   Linux:    /etc/secops/secops-sa.json
#   relative: ioc_extraction_agent/secops-sa.json      (name already in .gitignore)
# Leave empty to fall back to Application Default Credentials
# (gcloud auth application-default login, or GOOGLE_APPLICATION_CREDENTIALS).
SECOPS_CREDENTIALS_FILE=

# The hunt: how far back udm_search may look for each IOC. The last 7 days are
# searched first, and further back only if they found nothing (default and maximum
# 30; 0 turns it off). ~2-5 s per call.
SECOPS_HUNT_DAYS=

# The agent's reply: a readable Markdown report (default), or `json` for a program
# reading the answer. The JSON is always in session state (`ioc_report`).
IOC_REPORT_FORMAT=
